# Copy this file to .env and fill in your real Supabase project values.
# Expo automatically inlines any EXPO_PUBLIC_* variable into the JS bundle
# at build time (see src/services/supabaseClient.ts) - no extra config needed.
#
# Find these under Supabase Dashboard > Project Settings > API.
# The anon key is safe to ship in the app; it only grants what your Row
# Level Security policies (see supabase/schema.sql) explicitly allow -
# read-only access to categories/questions in this project.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
